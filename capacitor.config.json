{
  "appId": "com.businesscadence.calendar",
  "appName": "Business Cadence Command Center",
  "webDir": "dist/public",
  "server": {
    "url": "https://businesscadence.com",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#0F2440",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0F2440"
    }
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#0F2440",
    "preferredContentMode": "mobile"
  }
}
